# ----------------------------------------------------------------------
# ReturnLoad — environment variables
# Copy this file to `.env.local` and fill in values as needed.
# ----------------------------------------------------------------------

# --- Supabase (OPTIONAL) -----------------------------------------------
# PostgreSQL database + Authentication.
# When BOTH NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are
# non-empty, the app uses Supabase as its data backend and auth provider.
# When they are empty, the app runs in DEMO MODE backed by browser
# localStorage with clearly labelled, seeded sample data (so the entire
# marketplace is usable out of the box with no credentials).
#
# Setup: create a project at https://supabase.com, run `sql/schema.sql`
# in the SQL editor, enable Email auth, then set these two values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Map / routing (OPTIONAL) ------------------------------------------
# Used for live route geometry / detour estimates (Google Maps Platform
# Directions, or Mapbox Directions).
# When empty, the app falls back to city-based matching with haversine
# distances over a built-in city co-ordinate table. All such estimates
# are clearly labelled as estimates in the UI.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=